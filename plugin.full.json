{
    "id": "com.github.mattermost-message-status",
    "name": "Message Status",
    "description": "Shows delivery and read receipts (checkmarks) on your messages, similar to WhatsApp and Telegram.",
    "version": "1.0.3",
    "min_server_version": "9.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Message Status shows delivery and read receipts on your own messages.",
        "footer": "",
        "settings": []
    }
}
